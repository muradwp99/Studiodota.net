generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String    @default("Admin")
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// One row per editable page section / settings group. `data` is the section's
/// JSON payload; shape is defined by the page registry + content defaults.
model Block {
  key        String    @id
  data       Json
  draft      Json?
  snapshot   Json?
  snapshotAt DateTime?
  updatedAt  DateTime  @updatedAt
}

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  summary       String   @db.Text
  category      String
  sector        String
  location      String   @default("")
  year          String
  services      Json
  heroImage     String
  interiorImage String   @default("")
  gallery       Json     @default("[]")
  published     Boolean   @default(true)
  sort          Int       @default(0)
  seo           Json      @default("{}")
  snapshot      Json?
  snapshotAt    DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([deletedAt])
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @db.Text
  category    String
  date        String
  readingTime Int      @default(5)
  image       String
  inlineImage String   @default("")
  authorName  String
  authorRole  String
  intro       String    @db.Text
  sections    Json
  published   Boolean   @default(true)
  seo         Json      @default("{}")
  snapshot    Json?
  snapshotAt  DateTime?
  deletedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

model GalleryItem {
  id        String  @id @default(cuid())
  title     String
  sector    String
  image     String
  category  String
  type       String    @default("photo")
  youtubeId  String    @default("")
  tall       Boolean   @default(false)
  published  Boolean   @default(true)
  sort       Int       @default(0)
  snapshot   Json?
  snapshotAt DateTime?
  deletedAt  DateTime?

  @@index([deletedAt])
}

/// User-created pages built with the block editor (WordPress "Pages").
model Page {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  status         String    @default("published")
  blocks         Json
  draft          Json?
  snapshot       Json?
  snapshotAt     DateTime?
  seoTitle       String    @default("")
  seoDescription String    @default("")
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([deletedAt])
}

model Media {
  id        String    @id @default(cuid())
  path      String    @unique
  alt       String    @default("")
  mime      String    @default("")
  size      Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([deletedAt])
}

/// URL redirects applied by src/proxy.ts (301/308 or 302/307).
model Redirect {
  id        String   @id @default(cuid())
  from      String   @unique
  to        String
  permanent Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  message   String    @db.Text
  service   String    @default("")
  read      Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([deletedAt])
}
